# Copy to .env and replace placeholders. Never commit .env to version control.
# Generate SECRET_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate BOBCI_API_KEY: openssl rand -hex 32

ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
DATABASE_URL=sqlite:///./bobci.db
BOB_SHELL_PATH=bob

WATSONX_API_KEY=YOUR_API_KEY
WATSONX_PROJECT_ID=YOUR_PROJECT_ID
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

BOBCI_API_KEY=YOUR_API_KEY
SECRET_ENCRYPTION_KEY=YOUR_TOKEN

# Local development only — never enable in production
ALLOW_INSECURE_WEBHOOKS=false
